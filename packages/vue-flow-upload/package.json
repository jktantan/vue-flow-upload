{
  "name": "vue-flow-upload",
  "version": "0.1.0",
  "description": "A configurable Vue 3 upload component.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc --build tsconfig.json --force --emitDeclarationOnly",
    "typecheck": "vue-tsc --project tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src",
    "format": "prettier src --write",
    "format:check": "prettier src --check"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.2",
    "@nuxt/schema": "^4.5.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "sass": "^1.104.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "cropperjs": "^1.6.3",
    "v-viewer": "^3.0.23",
    "viewerjs": "^1.12.0",
    "vue-i18n-lite": "^1.0.2",
    "vue-picture-cropper": "^1.0.0"
  }
}
