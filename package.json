{
  "name": "vue-flow-upload-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm run build:lib && pnpm run build:playground && pnpm run build:docs",
    "build:lib": "pnpm --filter vue-flow-upload build",
    "build:playground": "pnpm --filter playground build",
    "docs:dev": "vitepress dev docs",
    "build:docs": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preview": "pnpm --filter playground preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter vue-flow-upload test",
    "lint": "eslint packages playground",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.3.11"
  }
}
